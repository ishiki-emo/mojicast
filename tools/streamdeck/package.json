{
  "name": "mojicast-streamdeck",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w --watch.onEnd=\"streamdeck restart com.ishiki-emo.mojicast\"",
    "validate": "streamdeck validate com.ishiki-emo.mojicast.sdPlugin",
    "pack": "streamdeck pack com.ishiki-emo.mojicast.sdPlugin -o dist -f"
  },
  "devDependencies": {
    "@elgato/cli": "^1.10.4",
    "@elgato/streamdeck": "^3.0.4",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.2",
    "@rollup/plugin-typescript": "^12.3.1",
    "@tsconfig/node20": "^20.1.10",
    "@types/node": "^24.19.2",
    "rollup": "^4.67.5",
    "tslib": "^2.9.1",
    "typescript": "^5.9.3"
  }
}
