# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
venv/

# ---- このプロジェクトの仮想環境・ビルド生成物 ----
reazonspeech-env/
build/
dist/

# ---- AIモデル（配布・DLで取得。リポジトリには含めない）----
models/
# 変換済みモデル（tools/convert_models.py で再生成可能・HFリポジトリへアップロードして配布）
/models_conv/

# ---- 上流 ReazonSpeech（別途 pip install する。README参照）----
/ReazonSpeech/

# ---- 実行時に生成/個人化されるデータ（data/ に集約。defaults/ の雛形は追跡する）----
/data/
/translate_error.log

# ---- 旧レイアウト（v0.2以前はルート直下）の残骸もコミットしない ----
/config.json
/hotwords.txt
/effects.json
/presets.json
/boxes.json
/banned.txt
/glossary.txt
/_hotwords_gen.txt

# ---- ベンチ成果物（変換済みモデル。スクリプトから再生成可能）----
bench/fugumt_ct2_*/
bench/*.onnx
bench/*.data
# 翻訳モデル比較のためにDL・変換したもの（bench/bench_*.py が自動で取り直す）
bench/jako_onnx_int8/
bench/nllb600m_ct2_int8/
bench/opus_en_ko_ct2_*/

# ---- 文字起こしログ（実行時に生成される個人データ）----
logs/

# ---- 個人テスト用の録音・音声 ----
*.wav

# ---- Claude Code のローカル/一時ファイル ----
.claude/settings.local.json
.claude/scheduled_tasks.lock

# ---- OS/エディタ ----
.DS_Store
Thumbs.db
.vscode/
.idea/

# マニュアル用スクショ（tools/manual/shoot.py で再生成可能）
tools/manual/shots/

# アプリアイコン（ビルド時に PNG から Mojicast.spec が再生成する）
assets/branding/*.ico
assets/branding/*.icns
tools/manual/videos/

# ---- Discord運営メモ（ローカル管理・公開しない）----
/Discord開設テンプレート.txt

# ---- assets/ は公開（PUSH）済みのものだけ追跡。未PUSHの素材・動画はローカル管理 ----
assets/*
!assets/branding/
assets/branding/*
!assets/branding/mojicast-mo-icon-light.png

# ---- tools/ の未PUSHスクリプト（ローカル管理・BOOTH素材生成/撮影用）----
tools/composite_booth_generated_type.py
tools/generate_booth_images.py
tools/manual/shoot_digest.py

# ---- 実配信の文字起こし（個人の配信内容。検証用に手元へ置くだけでコミットしない）----
/2026-*.txt
# ASR比較のためにDLした音声データセットとモデル（bench/bench_asr_multilingual.py が取り直す）
bench/fleurs_*/
bench/whisper_small_ct2/
bench/whisper_small_sherpa/
