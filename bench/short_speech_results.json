  "recording": {
    "0.25": [
      {
        "start": 0.518,
        "duration": 3.662,
        "text": "なわとび最後に跳んだのはいつだったか覚えてますか"
      },
      {
        "start": 4.55,
        "duration": 4.686,
        "text": "皆様おはようございます二千二十六年七月八日水曜日です"
      },
      {
        "start": 9.606,
        "duration": 2.638,
        "text": "毎日の雑談ヒントお届けします"
      },
      {
        "start": 12.742,
        "duration": 3.086,
        "text": "本日七月八日は縄の日です"
      },
      {
        "start": 16.166,
        "duration": 3.342,
        "text": "なわの語呂合わせで生まれた記念日なんです"
      },
      {
        "start": 20.294,
        "duration": 3.79,
        "text": "日本なわとびプロジェクトという団体が制定したんですよ"
      },
      {
        "start": 24.71,
        "duration": 4.334,
        "text": "縄跳びで基礎体力を高めようという願いが込められています"
      },
      {
        "start": 29.606,
        "duration": 5.55,
        "text": "実は十月二日もとびの日でとびの語呂合わせ"
      },
      {
        "start": 35.942,
        "duration": 4.078,
        "text": "二つの記念日で縄を持つ両手を表しているんだとか"
      },
      {
        "start": 40.774,
        "duration": 4.334,
        "text": "縄跳びはいつでもどこでも誰とでもできるのが魅力です"
      },
      {
        "start": 45.67,
        "duration": 5.07,
        "text": "運動としてだけでなく協調性やチャレンジ精神も育つんだとか"
      },
      {
        "start": 51.43,
        "duration": 4.526,
        "text": "私も子どもの頃は二重跳びの練習に夢中になりました"
      },
      {
        "start": 56.646,
        "duration": 4.014,
        "text": "初めて跳べた瞬間のうれしさは今でも覚えているんです"
      },
      {
        "start": 61.318,
        "duration": 4.782,
        "text": "大人になった今も一回跳べば気分まで弾みそうですよね"
      },
      {
        "start": 67.43,
        "duration": 3.054,
        "text": "皆様が得意だったのは何跳びですか"
      },
      {
        "start": 71.046,
        "duration": 5.39,
        "text": "それでは皆様今日も一日心も軽やかに弾む一日を"
      }
    ],
